# ==============================================================================
# AI Voice-Controlled Smart Classroom - Frontend Environment Template
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Only variables prefixed with VITE_ are accessible to the Vite client bundle!
# 2. All VITE_ variables are embedded into public client JavaScript during build.
# 3. The frontend must NEVER contain:
#    - MQTT username / password / credentials
#    - JWT secret
#    - MongoDB URI
#    - Gemini secret API key
# ==============================================================================

# Backend API Base URL (Publicly accessible URL where Express server is hosted)
# Local development : http://localhost:5000
# Production Render : https://your-smart-classroom-api.onrender.com
VITE_API_BASE_URL=http://localhost:5000
