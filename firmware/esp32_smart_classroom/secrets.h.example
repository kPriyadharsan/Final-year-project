#ifndef SECRETS_H
#define SECRETS_H

// ============================================================================
// SMART CLASSROOM ESP32 PRIVATE CREDENTIALS
// ============================================================================
// INSTRUCTIONS:
// 1. Copy or rename this file to "secrets.h" in the same directory:
//    cp secrets.h.example secrets.h
// 2. Fill in your real 2.4 GHz Wi-Fi and EMQX Cloud / MQTT credentials below.
// 3. "secrets.h" is ignored by .gitignore and will NEVER be committed to Git.
// ============================================================================

// 1. 2.4 GHz Wi-Fi Network Credentials (ESP32 supports 2.4 GHz b/g/n, not 5 GHz)
#define SECRET_WIFI_SSID       "YOUR_2.4GHZ_WIFI_SSID"
#define SECRET_WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// 2. MQTT Broker Host & Port
// For Production EMQX Cloud over TLS (Port 8883):
#define SECRET_MQTT_HOST       "z1910bc1.ala.us-east-1.emqxsl.com"
#define SECRET_MQTT_PORT       8883
#define SECRET_MQTT_USE_TLS    true

// For Local Testing / Embedded Broker (Port 1883, no TLS):
// #define SECRET_MQTT_HOST    "192.168.1.100" // PC IP address from ipconfig
// #define SECRET_MQTT_PORT    1883
// #define SECRET_MQTT_USE_TLS false

// 3. MQTT Broker Authentication
#define SECRET_MQTT_USER       "smart_esp32_user"
#define SECRET_MQTT_PASS       "your_secure_password"

// 4. MQTT Client Identifier
#define SECRET_MQTT_CLIENT_ID  "ESP32_SmartClassroom_Room302"

// 5. CA Root Certificate Validation
// Set to true to verify the EMQX Cloud server certificate against ISRG Root X1.
// Set to false during initial bench testing to skip certificate chain validation.
#define SECRET_USE_CA_CERT     true

#endif // SECRETS_H
