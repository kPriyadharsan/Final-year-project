# ==============================================================================
# AI Voice-Controlled Smart Classroom - Server Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `server/.env` (do NOT commit your real .env to git)
# 2. Fill in your local configuration and API keys below
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB & Mongoose)
# Local: mongodb://127.0.0.1:27017/smart_classroom
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_classroom
MONGODB_URI=mongodb://127.0.0.1:27017/smart_classroom

# Authentication Secret (Minimum 16 characters for signing JWT tokens)
JWT_SECRET=your_jwt_secret_key_minimum_32_chars_long

# Google Gemini AI API Key (REQUIRED for backend AI processing)
# NEVER expose this key to the frontend client or commit to version control.
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MQTT Broker Configuration (For IoT Smart Classroom Hardware Relays & Sensors)
# Local broker: mqtt://127.0.0.1:1883
# Public test broker: mqtt://broker.emqx.io:1883 or mqtt://test.mosquitto.org:1883
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=smart_classroom_admin
MQTT_PASSWORD=your_mqtt_password_here
MQTT_CLIENT_ID=smart_classroom_backend_server_01
