# ==============================================================================
# AI Voice-Controlled Smart Classroom - Server Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `server/.env`:
#      cp .env.example .env
# 2. Configure the values below for your environment (development / production).
# 3. NEVER commit your actual `server/.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# Port the Express HTTP and WebSocket server will listen on (1 - 65535)
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# Allowed Frontend Client Origin(s) for CORS allowlist.
# Development: http://localhost:5173
# Production : https://your-smart-classroom-app.vercel.app
# Multiple origins can be comma-separated: http://localhost:5173,https://your-domain.com
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Required)
# Development local: mongodb://127.0.0.1:27017/smart_classroom
# Production Atlas : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_classroom?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_classroom

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security (CRITICAL SECRET)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (JWT).
# Min 16 characters in development; min 32 characters in production.
# NEVER use placeholder values in production.
# Generate a secure key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API Configuration (SERVER-SIDE SECRET ONLY)
# ------------------------------------------------------------------------------
# Obtain API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If unset, the backend automatically uses deterministic rule-based command parsing.
# NEVER expose this key to frontend clients or version control.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 5. MQTT Broker Configuration (IoT Smart Classroom Relays & Sensors)
# ------------------------------------------------------------------------------
# MQTT Broker connection URL. Supported protocols: mqtt://, mqtts://, ws://, wss://, tcp://
# Local broker: mqtt://127.0.0.1:1883
# Production cloud broker: mqtts://broker.hivemq.com:8883
MQTT_BROKER_URL=mqtt://127.0.0.1:1883

# Unique MQTT client identifier for this server instance
MQTT_CLIENT_ID=smart_classroom_backend_server_01

# MQTT Authentication (leave empty if broker allows anonymous access)
MQTT_USERNAME=
MQTT_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Initial Super Admin CLI Seed Credentials (CLI SCRIPT ONLY)
# ------------------------------------------------------------------------------
# Used ONLY by `npm run seed:admin` to initialize the first administrator account.
# These credentials are NOT exposed via public API endpoints.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@smartclassroom.edu
SUPER_ADMIN_PASSWORD=SuperAdminSecure2026!
